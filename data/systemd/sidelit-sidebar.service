[Unit]
Description=Sidelit: the sidebar
Documentation=https://github.com/kulaxa/sidelit
PartOf=graphical-session.target
After=graphical-session.target sidelit-daemon.service
Wants=sidelit-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=15

[Service]
Type=simple
ExecStart=@BINDIR@/sidelit sidebar
EnvironmentFile=-%t/sidelit/session.env
Restart=always
# only our own process: what the daemon starts runs in scopes of its own (launch.py), and
# nothing it ever reopened may die with it
KillMode=process
RestartSec=1

[Install]
WantedBy=graphical-session.target
