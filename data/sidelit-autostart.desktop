[Desktop Entry]
Type=Application
Name=Sidelit
Comment=A workspace sidebar for COSMIC, KDE Plasma, GNOME, Hyprland, niri, Cinnamon, Xfce and MATE: one tab per workspace, with its agent's status
Exec=sidelit start
Terminal=false
NoDisplay=true
OnlyShowIn=KDE;COSMIC;GNOME;Hyprland;niri;X-Cinnamon;XFCE;MATE;LXDE;
X-GNOME-Autostart-enabled=true
