{
  "manifest_version": 3,
  "name": "Sidelit",
  "version": "0.9.0",
  "description": "Tells Sidelit which tabs each window has, so its windows come back on their workspaces, tabs and all.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage", "alarms"],
  "background": {"service_worker": "background.js"},
  "minimum_chrome_version": "116"
}
