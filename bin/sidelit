#!/bin/sh
# Sidelit launcher. Two processes, both systemd user services:
#   sidelit-daemon    keeps the layout (~/.config/sidelit/layout.json) and puts windows
#                     back; owns the connection to the compositor
#   sidelit-sidebar   the sidebar, a view of the daemon
# On GNOME, Sidelit's GNOME Shell extension runs the sidebar while the daemon runs, and the
# sidebar's log is in the journal as sidelit-sidebar.
#
#   sidelit [start]          start both (no-op if running; also what the autostart entry runs)
#   sidelit stop|restart|status
#   sidelit log              follow both logs
#   sidelit why [TEXT]       why windows were kept, moved, forgotten (the journal)
#   sidelit restore          start what is missing from the layout now (runs by itself after a login)
#   sidelit reapply          put every window back on its workspace and screen
#   sidelit state|layout     what the daemon sees / keeps, as JSON
#   sidelit hooks install|uninstall|status   Sidelit's plugin in Claude Code and Codex (status of every session)
#   sidelit chrome install|uninstall|status  the bridge to the Chrome extension
#   sidelit daemon|sidebar   run one in the foreground (the units do this)
#   sidelit ws list|toplevels|activate N|new NAME|pin N|unpin N|move A before|after B|movewin TITLE N
#   sidelit open URL         open a link in the browser window on the current workspace
#                            (or a new window there); also installed as sidelit-open
#   sidelit moveover         take over from this project's old install (start does it once)
#
# Without systemd user units (a checkout never installed) both run as plain background
# processes with pidfiles instead.
#
# Resolves the tree it lives in, so a symlink from ~/.local/bin, './bin/sidelit'
# in a checkout and a distro package (<prefix>/bin + <prefix>/share/sidelit) all work.
set -e

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
prefix=$(cd "$(dirname "$self")/.." && pwd)

root=
for candidate in "$prefix" "$prefix/share/sidelit"; do
    if [ -f "$candidate/sidelit/__main__.py" ]; then
        root=$candidate
        break
    fi
done
if [ -z "$root" ]; then
    echo "sidelit: cannot find the sidelit package near $prefix" >&2
    exit 1
fi
case ":${PYTHONPATH-}:" in
    *":$root:"*) ;;
    *) PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" ;;
esac
export PYTHONPATH
# Work from $root: `python3 -m` imports from the current directory first, so started inside
# another checkout of Sidelit, that checkout's package would run instead (set -e stops us if
# the cd fails).
cd "$root"

# Never pass a Claude Code session environment on (see __main__._scrub_claude_env)
# (CLAUDE_CONFIG_DIR is yours, not a session's: where Claude Code keeps its settings and plugins)
for v in $(env | sed -n 's/^\(CLAUDE[A-Z0-9_]*\)=.*/\1/p'); do
    [ "$v" = CLAUDE_CONFIG_DIR ] || unset "$v"
done
unset AI_AGENT

rundir="${XDG_RUNTIME_DIR:-/tmp}/sidelit"
mkdir -p "$rundir"
units="sidelit-daemon.service sidelit-sidebar.service"
log="${XDG_CACHE_HOME:-$HOME/.cache}/sidelit.log"

on_gnome() {
    [ "$(python3 -c 'from sidelit.backend import chosen; print(chosen())' 2>/dev/null)" = gnome ]
}

# the units to start: on GNOME the extension runs the sidebar, so only the daemon
start_units() {
    if on_gnome; then echo sidelit-daemon.service; else echo "$units"; fi
}

# the journal of both: on GNOME the sidebar's lines are GNOME Shell's, as sidelit-sidebar
journal() {
    if on_gnome; then
        journalctl --user "$@" _SYSTEMD_USER_UNIT=sidelit-daemon.service + SYSLOG_IDENTIFIER=sidelit-sidebar
    else
        journalctl --user "$@" -u sidelit-daemon -u sidelit-sidebar
    fi
}

# On GNOME nothing shows until the extension runs: say so, and how
gnome_hint() {
    on_gnome || return 0
    python3 -c 'from sidelit.gnome import extension_running as r; raise SystemExit(0 if r() else 1)' 2>/dev/null && return 0
    echo "sidelit: Sidelit's GNOME Shell extension is not running, so there is no sidebar yet. Turn it on:"
    echo "  gnome-extensions enable sidelit@kulaxa.github.io   (or in the Extensions app)"
    echo "  Just installed? Log out and back in once first: GNOME finds new extensions at login."
}

have_units() {
    command -v systemctl >/dev/null 2>&1 && systemctl --user cat sidelit-daemon.service >/dev/null 2>&1
}

# Session variables the systemd user manager lacks, for the apps the daemon starts (and, on
# Hyprland and niri, for the daemon itself: where the compositor's socket is; on X11, for the daemon and
# the sidebar: the X display and its key). An allow-list: whatever else is in this shell (API
# keys and the like) stays out.
write_session_env() {
    [ -n "${WAYLAND_DISPLAY-}" ] || [ -n "${DISPLAY-}" ] || return 0
    tmp="$rundir/session.env.tmp"
    : > "$tmp"
    chmod 600 "$tmp"
    for v in WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_SESSION_ID \
             XDG_SEAT XDG_VTNR SSH_AUTH_SOCK GTK_IM_MODULE QT_IM_MODULE XMODIFIERS CLUTTER_IM_MODULE \
             QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_AUTO_SCREEN_SCALE_FACTOR QT_ENABLE_HIGHDPI_SCALING \
             GDK_BACKEND MOZ_ENABLE_WAYLAND _JAVA_AWT_WM_NONREPARENTING XCURSOR_THEME XCURSOR_SIZE \
             HYPRLAND_INSTANCE_SIGNATURE NIRI_SOCKET SIDELIT_BACKEND CLAUDE_CONFIG_DIR; do
        eval "val=\${$v-}"
        [ -n "$val" ] || continue
        printf '%s="%s"\n' "$v" "$(printf '%s' "$val" | sed 's/\\/\\\\/g; s/"/\\"/g')" >> "$tmp"
    done
    mv -f "$tmp" "$rundir/session.env"
}

# The first start on a machine with this project's old install takes over from it, once
# (sidelit/moveover.py); one where Sidelit 0.5 wrote its hook into Claude Code's settings gets
# the plugin in its place, and Codex's copy of the plugin is refreshed after an update
# (sidelit/hooks.py). Never for a test instance, and never in the way of starting.
move_over() {
    [ -z "${SIDELIT_HOME-}" ] || return 0
    python3 -m sidelit moveover --if-needed || true
    python3 -m sidelit hooks upgrade || true
}

# SIDELIT_DRY_RUN and SIDELIT_HOME do not reach the systemd units: started, they would run as
# the real Sidelit (a test instance runs in the foreground: python3 -m sidelit daemon)
no_test_units() {
    [ "${SIDELIT_DRY_RUN-}" = 1 ] || [ -n "${SIDELIT_HOME-}" ] || return 0
    echo "sidelit: not started: SIDELIT_DRY_RUN and SIDELIT_HOME do not reach the systemd units, which would run as the real Sidelit" >&2
    exit 1
}

# a start without the units ran both with pidfiles; they must not run next to the units' ones
stop_legacy() {
    for pf in "$rundir/sidebar.pid" "$rundir/daemon.pid"; do
        [ -f "$pf" ] || continue
        pid=$(cat "$pf" 2>/dev/null || true)
        rm -f "$pf"
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    done
}

bg_running() { [ -f "$rundir/$1.pid" ] && kill -0 "$(cat "$rundir/$1.pid")" 2>/dev/null; }

bg_start() {
    bg_running "$1" && return 0
    if [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 2000000 ]; then mv -f "$log" "$log.1"; fi
    echo "=== sidelit $1 start $(date -Is) ===" >> "$log"
    setsid python3 -m sidelit "$1" >> "$log" 2>&1 &
    echo $! > "$rundir/$1.pid"
}

case ${1-start} in
    start)
        move_over
        write_session_env
        if have_units; then
            no_test_units
            [ -f "$rundir/sidebar.pid" ] && stop_legacy
            systemctl --user start $(start_units)
            echo "sidelit: started (logs: sidelit log)"
        else
            bg_start daemon
            sleep 0.5
            on_gnome || bg_start sidebar
            echo "sidelit: started without systemd units (log $log; install.sh sets them up)"
        fi
        gnome_hint
        ;;
    stop)
        if have_units; then systemctl --user stop $units; fi
        stop_legacy
        echo "sidelit: stopped"
        ;;
    restart)
        move_over
        write_session_env
        if have_units; then
            no_test_units
            stop_legacy
            systemctl --user restart $(start_units)
            echo "sidelit: restarted"
            gnome_hint
        else
            "$0" stop; sleep 0.3; exec "$0" start
        fi
        ;;
    status)
        if have_units; then
            systemctl --user --no-pager status $(start_units) 2>/dev/null | grep -E '^\S|Active:' || true
            on_gnome && echo "sidebar: run by Sidelit's GNOME Shell extension while the daemon runs"
            gnome_hint
            echo
            journal --no-pager -n 20 2>/dev/null || true
        else
            for p in daemon sidebar; do
                if [ $p = sidebar ] && on_gnome; then
                    echo "sidebar: run by Sidelit's GNOME Shell extension while the daemon runs"
                    gnome_hint
                elif bg_running $p; then echo "$p: running (pid $(cat "$rundir/$p.pid"))"; else echo "$p: not running"; fi
            done
            [ -f "$log" ] && tail -n 20 "$log"
        fi
        ;;
    log)
        if have_units; then
            journal -f -n 50
            exit $?
        fi
        exec tail -n 50 -f "$log"
        ;;
    daemon|sidebar)
        exec python3 -m sidelit "$1"
        ;;
    --foreground|-F)
        exec python3 -m sidelit sidebar
        ;;
    ws|open|state|layout|why|restore|reapply|reload|ping|hooks|chrome|moveover)
        exec python3 -m sidelit "$@"
        ;;
    --version|version)
        exec python3 -m sidelit version
        ;;
    *)
        sed -n '2,/^set -e/p' "$self" | sed 's/^# \?//;$d'; exit 2
        ;;
esac
