{
  "description": "Each Codex session's events, for Sidelit's tabs (hook.py)",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5, "async": true}]}
    ],
    "PostToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5, "async": true}]}
    ],
    "PermissionRequest": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "Interrupt": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 2}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/hooks/hook.py\" codex || true", "timeout": 2}]}
    ]
  }
}
